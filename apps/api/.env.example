# Export these in your terminal; the Go server does not auto-load .env files.
PORT=8080
APP_ENV=development
# Optional. Unset = health-only mode; set = connect and ping at startup.
# DATABASE_URL=postgresql://user:password@your-host/dbname?sslmode=require
# Separate direct URL for Goose (never the Neon -pooler hostname).
# MIGRATION_DATABASE_URL=postgresql://user:password@your-direct-host/dbname?sslmode=require

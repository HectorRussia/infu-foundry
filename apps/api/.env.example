# Copy to apps/api/.env for local dev: the pnpm scripts load it (shell variables win).
# The Go binaries themselves do not read .env files.
PORT=8080
APP_ENV=development
# Optional. Unset = health-only mode; set = connect and ping at startup.
# DATABASE_URL=postgresql://user:password@your-host/dbname?sslmode=require
# Separate direct URL for Goose (never the Neon -pooler hostname).
# MIGRATION_DATABASE_URL=postgresql://user:password@your-direct-host/dbname?sslmode=require
# Cloudflare R2 for video uploads. Use a token scoped to one bucket (dev locally, prod on Render).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=infu-media-dev
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

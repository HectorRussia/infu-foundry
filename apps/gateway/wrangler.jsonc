// Workers Free: static web + /api/* forwarded to API_ORIGIN (Go on Render).
// Set API_ORIGIN as a var and GATEWAY_SECRET with `wrangler secret put`.
// Paid Containers setup lives in wrangler.containers.jsonc. See docs/deployment.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infu-foundry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": { "API_ORIGIN": "https://infu-foundry-api.onrender.com" },
}

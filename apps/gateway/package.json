{
  "name": "@infu-foundry/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && node --test test/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:containers": "wrangler deploy --dry-run --containers-rollout=none --outdir dist --config wrangler.containers.jsonc",
    "preview": "wrangler dev --local --port 8787",
    "preview:containers": "wrangler dev --local --port 8787 --config wrangler.containers.jsonc",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "wrangler": "4.152.0",
    "@cloudflare/workers-types": "5.20261025.1",
    "typescript": "^5.9.0"
  }
}

{
  "name": "infu-foundry",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @infu-foundry/web dev",
    "dev:api": "node scripts/api.mjs run",
    "db:create": "node scripts/api.mjs migrate create",
    "db:status": "node scripts/api.mjs migrate status",
    "db:up": "node scripts/api.mjs migrate up",
    "db:down": "node scripts/api.mjs migrate down",
    "format": "prettier --write .",
    "check": "pnpm --filter @infu-foundry/web check && pnpm --filter @infu-foundry/gateway check && node scripts/api.mjs check",
    "build": "pnpm --filter @infu-foundry/web build && node scripts/api.mjs build && pnpm --filter @infu-foundry/gateway build",
    "preview:cloudflare": "pnpm --filter @infu-foundry/web build && pnpm --filter @infu-foundry/gateway preview",
    "preview:assets": "pnpm --filter @infu-foundry/web build && node scripts/preview-assets.mjs"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10"
  }
}
